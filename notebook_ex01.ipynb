   "source": [
    "import numpy as np\n",
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "# Data\n",
    "X = np.array([[1],[2],[3]])\n",
    "y = np.array([1,2,3])\n",
    "\n",
    "# Model\n",
    "model = LinearRegression().fit(X, y)\n",
    "\n",
    "print(\"coef_:\", model.coef_)\n",
    "print(\"intercept_:\", model.intercept_)\n",
    "print(\"predict(4):\", model.predict([[4]]))\n"
   ]
  },
